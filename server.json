{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "run.parlay/parlay",
  "title": "Parlay",
  "description": "Read-only MCP server for live Polymarket, Kalshi, Limitless odds; Manifold sentiment.",
  "version": "1.0.2",
  "websiteUrl": "https://parlay.run",
  "repository": {
    "url": "https://github.com/parlay-run/parlay-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.parlay.run/mcp",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {PARLAY_TOKEN}",
          "variables": {
            "PARLAY_TOKEN": {
              "description": "Parlay personal access token from https://parlay.run/settings/tokens",
              "isRequired": true,
              "isSecret": true,
              "placeholder": "parlay_pat_xxxxxxxxxxxx"
            }
          }
        }
      ]
    }
  ]
}
